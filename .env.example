POSTGRES_DB=jobradar
POSTGRES_USER=jobradar
POSTGRES_PASSWORD=change-this-local-password

# Use a unique random secret of at least 32 characters in production.
JOBRADAR_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JOBRADAR_JWT_EXPIRATION_HOURS=24

# Optional admin token for POST /api/admin/collect.
JOBRADAR_ADMIN_TOKEN=

# Optional Adzuna API integration. Register at https://developer.adzuna.com/
ADZUNA_ENABLED=false
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
ADZUNA_CITY=Pune
ADZUNA_RADIUS_KM=25
